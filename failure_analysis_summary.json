    "boundary_extent_imprecision_correct_species": {
      "description": "Species is correctly identified but the predicted region's shape/extent doesn't tightly match GT (over- or under-segmentation of an otherwise correctly-classified plant). This is architecture-dependent: it is the DOMINANT failure mode for the best-performing model (PGSS_YOLO11) and essentially absent from its worst-10 as a species error.",
      "count_of_70_worst_case_slots": 14,
      "most_affected_model": "PGSS_YOLO11 (7 of its 10 worst cases are correct-species/boundary-only, e.g. IMG_1801, IMG_1355, IMG_1379, IMG_1616, IMG_9673, IMG_1122, IMG_1617)"
    },
    "coarse_grid_blockiness_severe_undersegmentation": {
      "description": "SOLOv2-specific: predictions appear as coarse, blocky rectangular patches (visually obvious grid-cell artifacts) rather than smooth plant-shaped masks, and frequently miss large fractions of the true canopy -- direct visual confirmation of the documented architectural limitation (no decoder; 16x16 native grid with no per-instance mask head).",
      "count_of_70_worst_case_slots": 10,
      "affected_model": "SoloV2 only",
      "example_files": [
        "IMG_9705 (mostly missed)",
        "TRT_20_CR (blocky, Campsis->Madame Galen)",
        "IMG_1514 (blocky, mixed)"
      ]
    },
    "small_object_iou_sensitivity": {
      "description": "Species correctly identified and roughly correctly located, but the true instance is small (e.g. a young/sparse Hydrangea planting), so even a visually reasonable match yields a low IoU purely from small absolute pixel counts amplifying boundary noise -- a metric artifact, not a real qualitative failure.",
      "count_of_70_worst_case_slots": 3,
      "example_files": [
        "TRT_50_HA (appears in SegFormer, MaskRCNN, and PGSS_YOLO11's worst-10)"
      ]
    },
    "thin_stem_tendril_boundary_imprecision": {
      "description": "GT is a thin, wire-climbing tendril shape (Parthenocissus climbing along the grid wire); species is sometimes correctly identified (SegFormer) but the thin, high-perimeter-to-area shape is inherently hard to delineate precisely, cratering IoU despite a qualitatively reasonable prediction.",
      "count_of_70_worst_case_slots": 2,
      "example_files": [
        "IMG_9770_aug1_jpg (SegFormer: correct species, imprecise thin shape; DeepLabV3: also misidentifies the same thin shape as Hydrangea)"
      ]
    }
  },

{
  "methodology": "For each of 7 models (seed 42), the 10 test images with lowest per-image macro-IoU (classes present in GT or prediction only, matching the project's established per-image convention) were identified and rendered as [Original | GT | Prediction] overlay grids, then visually inspected image-by-image (not inferred from the aggregate confusion matrix).",
  "failure_mode_taxonomy": {
    "species_misidentification_wholesale": {
      "description": "The model classifies most/all of the correct foreground region as the WRONG species (not a boundary error -- the shape/extent is reasonable, the color/class is wrong). This is the dominant failure mode across all 7 models' worst-10 lists.",
      "count_of_70_worst_case_slots": 41,
      "campsis_madame_galen_confusion": {
        "instances_found": [
          {
            "file": "IMG_1144_aug1_jpg.rf.ccfffa01bbe8a6554048b891cf3ac3bd.jpg",
            "direction": "Campsis(GT) -> Madame Galen(pred)",
            "models_affected": [
              "DeepLabV3",
              "SegFormer",
              "MaskRCNN",
              "SoloV2",
              "YOLO11seg",
              "PGSS_YOLO11"
            ],
            "note": "Appears in the worst-10 of 6/7 models with the IDENTICAL error direction -- the single most consistent cross-architecture failure found in this analysis."
          },
          {
            "file": "IMG_9670_aug1_jpg.rf.f6286a20ba3a07c4dbf0.jpg",
            "direction": "Campsis(GT) -> Madame Galen(pred)",
            "models_affected": [

+class JointTrainTransform:
+    """LOTO: R1's training augmentations (same operations, parameters and order) applied to the
+    image AND its instance masks with torchvision.transforms.v2. R1 applied them to the image
+    only, so image and masks were misaligned. Masks use nearest-neighbour resampling and fill 0;
+    ColorJitter and Normalize act on the image only. Output: normalised 3x512x512 image and
+    N x 512 x 512 float masks, as in R1."""
+    joint = True
+
+    def __init__(self):
+        from torchvision.transforms import v2
+        self.t = v2.Compose([
+            v2.RandomHorizontalFlip(),
+            v2.RandomRotation(10),
+            v2.ColorJitter(brightness=0.2, contrast=0.2, saturation=0.2),
+            v2.RandomVerticalFlip(),
+            v2.RandomAffine(degrees=15, translate=(0.1, 0.1), scale=(0.9, 1.1)),
+            v2.RandomResizedCrop(512, scale=(0.8, 1.0)),
+            v2.ToDtype(torch.float32, scale=True),
+            v2.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
+        ])
+
+    def __call__(self, image_rgb, masks_native):
+        from torchvision import tv_tensors  # imported here: the object must stay picklable for DataLoader workers
+        img = tv_tensors.Image(torch.from_numpy(np.ascontiguousarray(image_rgb)).permute(2, 0, 1))
+        m = tv_tensors.Mask(torch.from_numpy(np.stack(masks_native)))
+        img, m = self.t(img, m)
+        return img.as_subclass(torch.Tensor), m.as_subclass(torch.Tensor).float()
+
+
